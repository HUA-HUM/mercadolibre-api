# Servicio
APP_PORT=8080
# Clave interna que piden los endpoints (header x-internal-api-key) y Bull Board.
INTERNAL_API_KEY=

# Sitio de documentacion (README + docs/). Sin usuario y clave queda abierto y
# no publica la pagina de operacion; con los dos pide credenciales y publica todo.
DOCS_SITE_ENABLED=true
DOCS_SITE_PATH=/docs
# DOCS_SITE_USER=
# DOCS_SITE_PASSWORD=

# Madre: guarda y entrega los tokens de Mercado Libre. Obligatorias.
MADRE_API_BASE_URL=
MADRE_INTERNAL_API_KEY=
# MADRE_API_TIMEOUT=30000

# Mercado Libre, cuenta principal (appKey "default")
MELI_AUTH_URL=https://api.mercadolibre.com/oauth/token
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=
MELI_REDIRECT_URI=
MELI_SELLER_ID=

# Mercado Libre, cuenta de promociones (appKey "promotions-engine-api")
MELI_PROMOTIONS_ENGINE_API_CLIENT_ID=
MELI_PROMOTIONS_ENGINE_API_CLIENT_SECRET=
MELI_PROMOTIONS_ENGINE_API_AUTH_URL=https://api.mercadolibre.com/oauth/token
MELI_PROMOTIONS_ENGINE_API_REDIRECT_URI=
MELI_PROMOTIONS_ENGINE_API_SELLER_ID=

# Redis (cola de eliminacion). REDIS_HOST es obligatoria.
# Cuidado: si apunta al Redis de produccion, el servicio local procesa la cola de produccion.
REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false
